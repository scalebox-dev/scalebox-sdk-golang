# Scalebox SDK E2E 测试环境变量配置
#
# 使用方法：
# 1. 复制此文件为 .env（不要提交 .env 到远端仓库，已在 .gitignore 中忽略）
#    cp .env.example .env
# 2. 填入你的测试环境配置
# 3. 直接运行 E2E 测试即可（测试会自动加载本目录的 .env）：
#    go test -tags e2e ./e2e_test/... -v
#
# 注意：
# - .env 文件包含敏感信息，请勿提交到远端仓库
# - E2E 测试会自动从 e2e_test/.env 加载环境变量

# ============================================================================
# Scalebox API 配置
# ============================================================================

# API 基础 URL（API 根地址，不含路径）
# - 公网: https://api.scalebox2.com
# - 本地 port-forward: http://127.0.0.1:8000
SCALEBOX_BASE_URL="https://api.scalebox2.com"

# API Key（E2E 测试专用 Root API Key）
SCALEBOX_API_KEY="sk-e2e0root0cli0sandbox00000000000000000000"

# ============================================================================
# E2E 测试专用配置
# ============================================================================

# Root 项目 ID
SCALEBOX_PROJECT_ID="prj-e2e0000000000001"

# 沙箱模板名称（默认 code-interpreter）
# SCALEBOX_TEMPLATE="code-interpreter"

# Redis 模板名称（默认 redis-e2e）
# SCALEBOX_REDIS_TEMPLATE="redis-e2e"

# Neko WebRTC 模板名称（默认 neko-webrtc-e2e）
# SCALEBOX_NEKO_TEMPLATE="neko-webrtc-e2e"

# ============================================================================
# OSS 配置（可选，OSS 相关测试需要）
# ============================================================================

E2E_OSS_URI="s3://scalebox-e2e"
E2E_OSS_ACCESS_KEY="your-access-key"
E2E_OSS_SECRET_KEY="your-secret-key"
E2E_OSS_ENDPOINT="https://s3.ap-east-1.amazonaws.com"
E2E_OSS_REGION="ap-east-1"

# 本批创建的沙盒数量（如 10 即创建 10 个，5 即创建 5 个）
E2E_BATCH_SIZE=2
