# Scalebox SDK 集成测试环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env（不要提交 .env 到远端仓库，已在 .gitignore 中忽略）
#    cp .env.example .env
# 2. 填入你的测试环境配置
# 3. 直接运行集成测试即可（测试会自动加载本目录或项目根目录的 .env）：
#    go test -tags integration ./integration_test/... -v
#
# 注意：
# - .env 文件包含敏感信息，请勿提交到远端仓库
# - 集成测试会自动从以下位置加载 .env：
#   1. integration_test/.env
#   2. 项目根目录的 .env
#   3. 当前工作目录的 .env

# ============================================================================
# Scalebox API 配置
# ============================================================================

# API 基础 URL（API 根地址，不含路径）
# - 公网: https://api.scalebox1.com
# - 本地 port-forward: http://127.0.0.1:8000
SCALEBOX_BASE_URL=https://api.scalebox.com

# API Key（从 Scalebox 控制台获取；E2E 默认: sk-e2e0root0cli0sandbox00000000000000000000）
SCALEBOX_API_KEY=your-api-key-here

# 沙箱模板名称（可选；默认 code-interpreter，与 helm-deployment 的 push-public-template.sh 注册的模板一致）
# 若环境有其他模板（如 base），可设置: SCALEBOX_TEMPLATE=base
# SCALEBOX_TEMPLATE=code-interpreter
